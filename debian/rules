#!/usr/bin/make -f
# -*- makefile -*-

export DH_VERBOSE=1

# If vendor/ + .cargo/config.toml are present (see
# debian/scripts/prepare-offline-build.sh), Cargo must not touch the network
# at all — required for a Launchpad PPA build, whose builders have no
# general internet access. Corrosion invokes `cargo build` internally as
# part of the CMake build below, so there's no cargo command of our own to
# pass --offline to directly; CARGO_NET_OFFLINE is the equivalent env var
# that reaches it transitively. Same reasoning for CMake finding a vendored
# third_party/corrosion/ instead of fetching it (see CMakeLists.txt).
ifneq ($(wildcard $(CURDIR)/vendor),)
export CARGO_NET_OFFLINE=true
endif

# Corrosion's FindRust.cmake normally resolves the active toolchain by
# invoking `rustup toolchain list --verbose` and parsing its output — in the
# CI container that call comes back empty (rustup env vars matched a working
# standalone invocation byte for byte, so the exact cause is unclear), which
# FindRust.cmake's regex misparses, failing the configure with "the rustc
# executable was not found". Sidestep the whole rustup-toolchain-list path by
# pointing Rust_COMPILER/Rust_CARGO straight at the real (non-proxy) rustc/
# cargo inside the active toolchain's sysroot: FindRust.cmake detects (and
# discards) a user-specified Rust_COMPILER only when it resolves to rustup's
# proxy shim, so handing it the real binary keeps it and never calls rustup.
RUST_SYSROOT := $(shell rustc --print sysroot)

# Same "ask qtpaths6 instead of hardcoding a path" reasoning as the wizard's
# own QML/plugin path discovery at runtime (see wizard/src/main.rs) —
# QT_INSTALL_BINS varies by distro/architecture, unlike the wizard runtime's
# QT_INSTALL_QML/QT_INSTALL_PLUGINS lookups this mirrors build-time.
QT_BINS := $(shell qtpaths6 --query QT_INSTALL_BINS)

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DRust_COMPILER=$(RUST_SYSROOT)/bin/rustc \
		-DRust_CARGO=$(RUST_SYSROOT)/bin/cargo

override_dh_auto_build:
	dh_auto_build
	# daemon/ and wizard/ are plain Cargo, not part of the CMake/Corrosion
	# graph that builds core/ + the KIO plugin above — build the whole
	# workspace separately in one go (wizard/ depends on daemon/'s lib,
	# which depends on core/, so a single --workspace build lets Cargo
	# resolve that once instead of two independent --manifest-path
	# invocations). This does mean core/ gets compiled twice overall (once
	# as a staticlib via Corrosion for the cxx bridge, once as an rlib here
	# for daemon/wizard to link), which is harmless duplication, not a bug.
	cargo build --release --locked --workspace

override_dh_auto_test:
	# Runs the Rust unit tests (core/ + daemon/), which need no KF6/Qt6
	# runtime and no Proton Drive session (see core/src/cli.rs's
	# CommandRunner mocking, reused by daemon/'s own tests the same way).
	cargo test --workspace --profile ci
	# worker/tests/'s QTest suite (issue #90) — QTEST_GUILESS_MAIN, so no
	# display/D-Bus session needed either.
	dh_auto_test

override_dh_auto_install:
	dh_auto_install
	install -Dm755 target/release/kio-protondrive-daemon \
		debian/tmp/usr/bin/kio-protondrive-daemon
	install -Dm755 target/release/kio-protondrive-wizard \
		debian/tmp/usr/bin/kio-protondrive-wizard
	install -d debian/tmp/usr/share/kio-protondrive-wizard/qml
	install -m644 wizard/qml/*.qml \
		debian/tmp/usr/share/kio-protondrive-wizard/qml/
	# Compiled here (not committed) — same source-vs-build-artifact split as
	# the KI18n .po -> .mo compilation ki18n_install(po) does for the worker
	# and daemon's own translations. Loaded by wizard/src/main.rs's
	# resolve_locale()/find_qml_translation_path() via `qml6 --translation`.
	install -d debian/tmp/usr/share/kio-protondrive-wizard/translations
	for ts in wizard/translations/*.ts; do \
		lang=$$(basename $$ts .ts); \
		$(QT_BINS)/lrelease $$ts \
			-qm debian/tmp/usr/share/kio-protondrive-wizard/translations/$$lang.qm; \
	done
