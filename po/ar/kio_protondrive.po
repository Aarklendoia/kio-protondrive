#. Virtual root section: /my-files
#: worker/protondriveworker.cpp:0
msgid "My files"
msgstr "ملفاتي"

#. Virtual root section: /devices
#: worker/protondriveworker.cpp:0
msgid "Computers"
msgstr "أجهزة الكمبيوتر"

#. Virtual root section: /photos
#: worker/protondriveworker.cpp:0
msgid "Photos"
msgstr "الصور"

#. Virtual root section: /shared-by-me
#: worker/protondriveworker.cpp:0
msgid "Shared"
msgstr "التي شاركتها"

#. Virtual root section: /shared-with-me
#: worker/protondriveworker.cpp:0
msgid "Shared with me"
msgstr "التي شوركت معي"

#. Virtual root section: /trash
#: worker/protondriveworker.cpp:0
msgid "Trash"
msgstr "سلة المهملات"

#. Virtual root section: /albums (not confirmed against Proton's own
#. wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Albums"
msgstr "الألبومات"

#. Virtual root section: /photos-shared-by-me (not confirmed against
#. Proton's own wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Photos shared by me"
msgstr "الصور التي شاركتها"

#. Virtual root section: /photos-shared-with-me (not confirmed against
#. Proton's own wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Photos shared with me"
msgstr "الصور التي شوركت معي"

#. Virtual root section: /photos-trash (not confirmed against Proton's own
#. wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Photos trash"
msgstr "سلة مهملات الصور"

#. Shown as a KIO "could not log in" error when the proton-drive CLI
#. reports no active session.
#: worker/protondriveworker.cpp:0
msgid "Not logged in to Proton Drive. Run \"proton-drive auth login\" in a terminal, then try again."
msgstr "لم يتم تسجيل الدخول إلى Proton Drive. شغّل «proton-drive auth login» في الطرفية، ثم أعد المحاولة."

#. Right-click menu action (KAbstractFileItemActionPlugin): downloads the
#. selected item(s) and keeps them available locally indefinitely, shown
#. when at least one selected item isn't pinned yet.
#: worker/fileitemactionplugin.cpp:0
msgid "Keep Available Offline"
msgstr "إبقاء متاحًا دون اتصال"

#. Right-click menu action (KAbstractFileItemActionPlugin): un-pins the
#. selected item(s), shown when at least one selected item is pinned.
#: worker/fileitemactionplugin.cpp:0
msgid "Remove Local Copy"
msgstr "إزالة النسخة المحلية"

#. Right-click menu action (KAbstractFileItemActionPlugin): moves a trashed
#. item back to its original location, shown when every selected item is
#. under /trash.
#: worker/fileitemactionplugin.cpp:0
msgid "Restore"
msgstr "استعادة"

#. Right-click menu action shown on the /trash virtual section itself, and
#. also the confirmation dialog's title and primary button — permanently
#. deletes everything currently in the trash.
#: worker/fileitemactionplugin.cpp:0
msgid "Empty Trash"
msgstr "إفراغ المهملات"

#. Confirmation dialog text shown before actually emptying the trash
#. (irreversible, not routed through a KIO job Dolphin would confirm on its
#. own).
#: worker/fileitemactionplugin.cpp:0
msgid "Permanently delete everything in the trash? This cannot be undone."
msgstr "هل تريد حذف كل محتويات المهملات نهائيًا؟ لا يمكن التراجع عن هذا الإجراء."

#. Photo filter category (photo_categories.h): the web app's "Favorites" tab (photos tagged as favorite server-side).
#: worker/protondriveworker.cpp:0
msgid "Favorites"
msgstr "المفضلة"

#. Photo filter category: screenshots.
#: worker/protondriveworker.cpp:0
msgid "Screenshots"
msgstr "لقطات الشاشة"

#. Photo filter category: videos.
#: worker/protondriveworker.cpp:0
msgid "Videos"
msgstr "مقاطع الفيديو"

#. Photo filter category: iOS Live Photos and Android Motion Photos (combined into one filter, matching Proton's own web client).
#: worker/protondriveworker.cpp:0
msgid "Live Photos"
msgstr "الصور الحية"

#. Photo filter category: selfies.
#: worker/protondriveworker.cpp:0
msgid "Selfies"
msgstr "سيلفي"

#. Photo filter category: portrait-mode photos.
#: worker/protondriveworker.cpp:0
msgid "Portraits"
msgstr "صور شخصية"

#. Photo filter category: burst-mode photo sequences.
#: worker/protondriveworker.cpp:0
msgid "Bursts"
msgstr "اللقطات المتتالية"

#. Photo filter category: panoramas.
#: worker/protondriveworker.cpp:0
msgid "Panoramas"
msgstr "البانوراما"

#. Photo filter category: RAW-format camera files.
#: worker/protondriveworker.cpp:0
msgid "RAW"
msgstr "RAW"

#. Right-click menu action (KAbstractFileItemActionPlugin), background right-click on /photos or one of its filter category folders: opens a submenu of the 9 filter categories.
#: worker/fileitemactionplugin.cpp:0
msgid "Filter Photos"
msgstr "تصفية الصور"

#. Submenu entry (see "Filter Photos" above), only shown while already viewing a filter category: clears back to the unfiltered /photos listing.
#: worker/fileitemactionplugin.cpp:0
msgid "All Photos"
msgstr "كل الصور"

#. Context-menu action (KAbstractFileItemActionPlugin) opening the sharing dialog for a single selected item.
#: worker/fileitemactionplugin.cpp:0
msgid "Share"
msgstr "مشاركة"

#. ShareDialog window title; %1 is the item's display name.
#: worker/sharedialog.cpp:0
msgid "Share \"%1\""
msgstr "مشاركة \"%1\""

#. ShareDialog: heading for the list of current members/pending invitations.
#: worker/sharedialog.cpp:0
msgid "People with access"
msgstr "الأشخاص الذين لديهم صلاحية الوصول"

#. ShareDialog: button removing the selected member/invitation.
#: worker/sharedialog.cpp:0
msgid "Remove Access"
msgstr "إزالة الوصول"

#. Sharing role: read-only access.
#: worker/sharedialog.cpp:0
msgid "Viewer"
msgstr "مُشاهد"

#. Sharing role: can edit.
#: worker/sharedialog.cpp:0
msgid "Editor"
msgstr "محرِّر"

#. Sharing role: full control (invite role only, not offered for public links).
#: worker/sharedialog.cpp:0
msgid "Admin"
msgstr "مسؤول"

#. ShareDialog: placeholder text for the invite email field.
#: worker/sharedialog.cpp:0
msgid "Email address"
msgstr "عنوان البريد الإلكتروني"

#. ShareDialog: button sending an invitation.
#: worker/sharedialog.cpp:0
msgid "Invite"
msgstr "دعوة"

#. ShareDialog: placeholder text for the optional invitation message field.
#: worker/sharedialog.cpp:0
msgid "Message (optional)"
msgstr "رسالة (اختياري)"

#. ShareDialog: suffix appended after a member's email/role when their invitation hasn't been accepted yet.
#: worker/sharedialog.cpp:0
msgid "— pending"
msgstr "— قيد الانتظار"

#. ShareDialog: read-only status line (editorsCanShare = true, no CLI setter exists for it).
#: worker/sharedialog.cpp:0
msgid "Editors can invite others to this item."
msgstr "يمكن للمحررين دعوة أشخاص آخرين إلى هذا العنصر."

#. ShareDialog: read-only status line (editorsCanShare = false).
#: worker/sharedialog.cpp:0
msgid "Only you can invite others to this item."
msgstr "أنت فقط من يمكنه دعوة أشخاص آخرين إلى هذا العنصر."

#. ShareDialog: heading for the public-link section.
#: worker/sharedialog.cpp:0
msgid "Public link"
msgstr "رابط عام"

#. ShareDialog: button copying the public link URL to the clipboard.
#: worker/sharedialog.cpp:0
msgid "Copy"
msgstr "نسخ"

#. ShareDialog: placeholder text for the optional public-link password field.
#: worker/sharedialog.cpp:0
msgid "Password (optional)"
msgstr "كلمة المرور (اختياري)"

#. ShareDialog: label next to the public-link expiration date checkbox/picker.
#: worker/sharedialog.cpp:0
msgid "Expires on:"
msgstr "تنتهي الصلاحية في:"

#. ShareDialog: button creating a new public link or updating the existing one's settings.
#: worker/sharedialog.cpp:0
msgid "Create/Update Link"
msgstr "إنشاء/تحديث الرابط"

#. ShareDialog: button removing the public link.
#: worker/sharedialog.cpp:0
msgid "Remove Link"
msgstr "إزالة الرابط"

#. ShareDialog: status text shown when stat's isSharedByUrl is true but the URL itself isn't known yet (sharing status doesn't carry it).
#: worker/sharedialog.cpp:0
msgid "A public link is currently active. Use \"Create/Update Link\" to view or change it."
msgstr "يوجد حاليًا رابط عام نشط. استخدم \"إنشاء/تحديث الرابط\" لعرضه أو تغييره."

#. ShareDialog: status text shown when the item has no public link.
#: worker/sharedialog.cpp:0
msgid "No public link."
msgstr "لا يوجد رابط عام."

#. ShareDialog: status text shown right after creating/updating a public link.
#: worker/sharedialog.cpp:0
msgid "Public link active."
msgstr "الرابط العام نشط."

#. Message box title for sharing errors (QMessageBox::warning).
#: worker/sharedialog.cpp:0
msgid "Sharing"
msgstr "المشاركة"
