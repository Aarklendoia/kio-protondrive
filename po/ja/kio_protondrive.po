#. Virtual root section: /my-files
#: worker/protondriveworker.cpp:0
msgid "My files"
msgstr "マイファイル"

#. Virtual root section: /devices
#: worker/protondriveworker.cpp:0
msgid "Computers"
msgstr "コンピューター"

#. Virtual root section: /photos
#: worker/protondriveworker.cpp:0
msgid "Photos"
msgstr "写真"

#. Virtual root section: /shared-by-me
#: worker/protondriveworker.cpp:0
msgid "Shared"
msgstr "共有中"

#. Virtual root section: /shared-with-me
#: worker/protondriveworker.cpp:0
msgid "Shared with me"
msgstr "共有された項目"

#. Virtual root section: /trash
#: worker/protondriveworker.cpp:0
msgid "Trash"
msgstr "ゴミ箱"

#. Virtual root section: /albums (not confirmed against Proton's own
#. wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Albums"
msgstr "アルバム"

#. Virtual root section: /photos-shared-by-me (not confirmed against
#. Proton's own wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Photos shared by me"
msgstr "自分が共有した写真"

#. Virtual root section: /photos-shared-with-me (not confirmed against
#. Proton's own wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Photos shared with me"
msgstr "共有された写真"

#. Virtual root section: /photos-trash (not confirmed against Proton's own
#. wording — not shown as a top-level entry in the web UI)
#: worker/protondriveworker.cpp:0
msgid "Photos trash"
msgstr "写真のゴミ箱"

#. Shown as a KIO "could not log in" error when the proton-drive CLI
#. reports no active session.
#: worker/protondriveworker.cpp:0
msgid "Not logged in to Proton Drive. Run \"proton-drive auth login\" in a terminal, then try again."
msgstr "Proton Drive にログインしていません。ターミナルで「proton-drive auth login」を実行してから、もう一度お試しください。"

#. Right-click menu action (KAbstractFileItemActionPlugin): downloads the
#. selected item(s) and keeps them available locally indefinitely, shown
#. when at least one selected item isn't pinned yet.
#: worker/fileitemactionplugin.cpp:0
msgid "Keep Available Offline"
msgstr "オフラインで利用可能にする"

#. Right-click menu action (KAbstractFileItemActionPlugin): un-pins the
#. selected item(s), shown when at least one selected item is pinned.
#: worker/fileitemactionplugin.cpp:0
msgid "Remove Local Copy"
msgstr "ローカルコピーを削除"

#. Right-click menu action (KAbstractFileItemActionPlugin): moves a trashed
#. item back to its original location, shown when every selected item is
#. under /trash.
#: worker/fileitemactionplugin.cpp:0
msgid "Restore"
msgstr "復元"

#. Right-click menu action shown on the /trash virtual section itself, and
#. also the confirmation dialog's title and primary button — permanently
#. deletes everything currently in the trash.
#: worker/fileitemactionplugin.cpp:0
msgid "Empty Trash"
msgstr "ゴミ箱を空にする"

#. Confirmation dialog text shown before actually emptying the trash
#. (irreversible, not routed through a KIO job Dolphin would confirm on its
#. own).
#: worker/fileitemactionplugin.cpp:0
msgid "Permanently delete everything in the trash? This cannot be undone."
msgstr "ゴミ箱の中身をすべて完全に削除しますか? この操作は元に戻せません。"
