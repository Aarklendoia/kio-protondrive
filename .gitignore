# Rust
/target/
Cargo.lock
**/*.rs.bk
*.pdb

# Vendored deps + vendored Corrosion source for offline Launchpad/PPA builds
# (regenerated per release, see debian/scripts/prepare-offline-build.sh) —
# not meant to live in git.
/vendor/
/.cargo/
/third_party/corrosion/

# CMake build directories: /build/ for a manual `cmake -B build`, /build-*/
# for an alternate local one (e.g. a separate `~/.local`-prefixed install
# used to manually test a change without touching the system install),
# obj-*/ for debhelper's cmake buildsystem (dh_auto_configure names it
# obj-$(DEB_HOST_GNU_TYPE), e.g. obj-x86_64-linux-gnu, when driven by
# dpkg-buildpackage).
/build/
/build-*/
/obj-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
compile_commands.json

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.so
*.a
*.o
*.dylib

# Debian packaging
debian/tmp/
debian/.debhelper/
debian/kio-protondrive/
debian/kio-protondrive-sync-daemon/
debian/kio-protondrive-full/
debian/*.substvars
debian/*.debhelper
debian/files
debian/.debhelper.log
debian/debhelper-build-stamp
../*.deb
../*.buildinfo
../*.changes
../*.dsc
../*.tar.*
*.deb
*.buildinfo
*.changes
.debhelper-build-stamp

# Coverage / docs
*.profdata
/coverage-html/
target/doc/

# Logs
*.log
