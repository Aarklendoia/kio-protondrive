<!--
  The OBS package's sources (#201): the spec and the two tarballs
  packaging/rpm/make-sources.sh writes, which .github/workflows/publish-obs.yml
  attaches to each GitHub release before triggering this service.
-->
<services>
  <service name="download_url">
    <param name="url">https://github.com/Aarklendoia/kio-protondrive/releases/latest/download/kio-protondrive.spec</param>
  </service>
  <service name="download_url">
    <param name="url">https://github.com/Aarklendoia/kio-protondrive/releases/latest/download/kio-protondrive-source.tar.gz</param>
  </service>
  <service name="download_url">
    <param name="url">https://github.com/Aarklendoia/kio-protondrive/releases/latest/download/kio-protondrive-vendor.tar.xz</param>
  </service>
</services>
